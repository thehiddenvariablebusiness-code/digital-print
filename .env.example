# Application URL
APP_URL="http://localhost:3000"

# Shop Identifier
VITE_SHOP_ID="shop_digital_print_01"
SHOP_ID="shop_digital_print_01"

# Windows Print Agent Secret Key (for agent authentication)
SHOP_API_KEY="agent_secret_key_change_in_production"

# Payment Configuration
# Options: test | upi_qr | merchant
PAYMENT_PROVIDER="test"
PAYMENT_API_KEY=""
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET="whsec_sample_secret_key_12345"

# Print Mode
# Options: simulation | windows
PRINT_MODE="simulation"

# Firebase Client Configuration (Vite environment variables)
# Obtain these from Firebase Console -> Project Settings -> General -> Web apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Admin / Server SDK (Optional for server-side verification)
SERVER_FIREBASE_PROJECT_ID=""
SERVER_FIREBASE_CLIENT_EMAIL=""
SERVER_FIREBASE_PRIVATE_KEY=""
